# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Configuration (Port 5433 mapped via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rre_db

# Redis Infrastructure Configuration
REDIS_URL=redis://localhost:6379

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=dummy_secret_key
WEBHOOK_SECRET=dummy_webhook_secret

# Security & Encryption Configuration
JWT_SECRET=super_secret_jwt_key_minimum_32_chars
ENCRYPTION_KEY=your_high_entropy_32_byte_hex_encryption_key_here
JWT_EXPIRES_IN=1d

# Optional AI Advisory Explanation Integration
LLM_API_KEY=your_llm_api_key_here

